{
  "name": "kdbx-wasm",
  "version": "0.3.1",
  "description": "KDBX password database parser for JavaScript/WebAssembly - Fast and secure KeePass KDBX 4 file parser",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.js",
      "default": "./index.js"
    },
    "./kdbx_wasm.js": "./kdbx_wasm.js",
    "./kdbx_wasm_bg.wasm": {
      "types": "./kdbx_wasm_bg.wasm.d.ts",
      "default": "./kdbx_wasm_bg.wasm"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "database.js",
    "entry-fields.js",
    "index.d.ts",
    "kdbx_wasm.js",
    "kdbx_wasm_bg.wasm",
    "LICENSE",
    "README.md",
    "kdbx_wasm_bg.wasm.d.ts"
  ],
  "scripts": {
    "test": "node --test tests/smoke.test.js",
    "benchmark": "node ../../benchmarks/open-db.mjs"
  },
  "keywords": [
    "kdbx",
    "keepass",
    "password",
    "password-manager",
    "wasm",
    "webassembly",
    "rust",
    "encryption",
    "security"
  ],
  "author": "yzbtdiy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzbtdiy/kdbx-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/yzbtdiy/kdbx-wasm/issues"
  },
  "homepage": "https://github.com/yzbtdiy/kdbx-wasm#readme",
  "engines": {
    "node": ">=19.0.0"
  }
}
